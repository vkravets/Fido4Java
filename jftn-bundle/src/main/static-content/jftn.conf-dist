#
# Path to inbound boundles
#
Inbound = /home/toch/ftntest/inb/

#
# Path to temp directory
#
Tmp = /home/toch/tmp/

#
# Path to echo base
#
EchoPath = /home/toch/tmp/echos/

#
# Debug level
#
debuglevel=1

#
# Links description
# Link=<Link address>,<Out AKA>,<password>[,host address]
#
Link=2:5030/1111.0,2:5030/1111.1111,12345678

#
# SysOp name
#
SysOp=Dmitriy Tochansky

deletetossed=1

Outbound = /home/toch/ftn/var/spool/outbound

