# Manual configuration example. Not installed as jftn.conf: first launch uses the wizard.
System=JFtn
PreserveReceivedFiles=true
# Original received files are retained without automatic expiration.
# File-only settings can be placed in conf.d/*.conf beside jftn.conf.
# ReceivedArchivePath=./mail/received
Location=Your Location

#
# Path to inbound boundles
#
Inbound = ./mail/inbound/

#
# Path to temp directory
#
Tmp = ./mail/tmp/

#
# Path to echo base
#
EchoPath = ./mail/echo/

#
# Debug level
#
debuglevel=1

#
# Links description
# Link=<Link address>,<Out AKA>,<password>[,host address]
#
Link=1:500/101,1:500/100,-,localhost:24554

#
# SysOp name
#
SysOp=Your Name

deletetossed=1

Outbound = ./mail/outbound/

# Plugin internals and mail robots are configured in conf.d/*.conf.
# First startup creates commented examples without replacing existing files.
# See conf.d/README.txt and docs/plugin-configuration.md.
# This browser origin is UI-managed; do not move it to a fragment.
# RpcHttpOrigin=http://localhost:9091
