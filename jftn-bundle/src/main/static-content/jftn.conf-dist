# Manual configuration example. Not installed as jftn.conf: first launch uses the wizard.
System=JFtn
PreserveReceivedFiles=true
# Original received files are retained without automatic expiration.
# File-only settings can be placed in conf.d/*.conf beside jftn.conf.
# ReceivedArchivePath=./mail/received
Location=Your Location

#
# Path to inbound boundles
#
Inbound = ./mail/inbound/

#
# Path to temp directory
#
Tmp = ./mail/tmp/

#
# Path to echo base
#
EchoPath = ./mail/echo/

#
# Debug level
#
debuglevel=1

#
# Links description
# Link=<Link address>,<Out AKA>,<password>[,host address]
#
Link=1:500/101,1:500/100,-,localhost:24554

#
# SysOp name
#
SysOp=Your Name

deletetossed=1

# Duplicate messages are retained separately, never forwarded or sent to robots again.
# File-only policy; restart after changing these settings.
DupeAction=move
# DupePath defaults to the dupes subdirectory of Tmp.
# DupePath=./mail/tmp/dupes
# DupeAction=discard suppresses duplicates without keeping a separate message copy.

# Unknown echoes are rejected unless both the master switch and a sender rule allow creation.
# Requires EchoSubscriptions=database (the default AreaFix plugin configuration).
AutoCreateEcho=false
EnforceEchoAccess=true
# AutoCreateEchoFrom=1:500/101,WRITE
# WRITE receives from this link; BOTH also permits sending back. Existing rights stay unchanged.

Outbound = ./mail/outbound/

# Plugin internals and mail robots are configured in conf.d/*.conf.
# First startup creates default plugin files without replacing existing files.
# See conf.d/README.txt and docs/plugin-configuration.md.
# This browser origin is UI-managed; do not move it to a fragment.
# RpcHttpOrigin=http://localhost:9091
