{
    "name": "jftn-web-ui",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write src test *.ts *.json index.html",
        "format:check": "prettier --check src test *.ts *.json index.html",
        "test": "node --experimental-strip-types --test test/*.test.ts"
    },
    "dependencies": {
        "vue": "3.5.44",
        "node-int64": "0.4.0",
        "buffer": "6.0.3",
        "thrift": "0.25.0"
    },
    "devDependencies": {
        "vite": "8.3.4",
        "@vitejs/plugin-vue": "6.0.10",
        "typescript": "6.0.3",
        "vue-tsc": "3.3.13",
        "prettier": "3.9.10",
        "@types/node-int64": "0.4.32",
        "@types/node": "26.6.5"
    }
}
