{
    "name": "jftn-web-ui",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write src test stories .storybook *.ts *.json index.html",
        "format:check": "prettier --check src test stories .storybook *.ts *.json index.html",
        "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open --disable-telemetry",
        "build-storybook": "storybook build --output-dir ../build/storybook --disable-telemetry",
        "typecheck:storybook": "vue-tsc --noEmit -p tsconfig.storybook.json",
        "test:ui": "playwright test --config playwright.config.ts",
        "test:ui:install": "playwright install chromium",
        "test": "node --experimental-strip-types --test test/*.test.ts"
    },
    "dependencies": {
        "buffer": "6.0.3",
        "node-int64": "0.4.0",
        "thrift": "0.25.0",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@storybook/vue3-vite": "10.6.2",
        "@types/node": "26.6.5",
        "@types/node-int64": "0.4.32",
        "@vitejs/plugin-vue": "6.0.10",
        "prettier": "3.9.10",
        "storybook": "10.6.2",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "vue-tsc": "3.3.13"
    }
}
